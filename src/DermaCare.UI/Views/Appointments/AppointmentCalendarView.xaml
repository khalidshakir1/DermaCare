<UserControl x:Class="DermaCare.UI.Views.Appointments.AppointmentCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <DatePicker Width="160"
                            SelectedDate="{Binding SelectedDate}"
                            materialDesign:HintAssist.Hint="Date"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Margin="0,0,12,0" />
                <ComboBox Width="220"
                          ItemsSource="{Binding Doctors}"
                          SelectedItem="{Binding SelectedDoctorFilter}"
                          DisplayMemberPath="User.FullName"
                          materialDesign:HintAssist.Hint="Filter by Doctor"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,12,0" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Walk-In"
                        Command="{Binding WalkInCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" />
                <Button Content="Book Appointment"
                        Command="{Binding NewAppointmentCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </StackPanel>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Appointments}"
                  SelectedItem="{Binding SelectedAppointment}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding AppointmentTime}" Width="90" />
                <DataGridTextColumn Header="Patient" Binding="{Binding Patient.FullName}" Width="190" />
                <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor.User.FullName}" Width="190" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Workflow Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Confirm" Command="{Binding ConfirmCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Start Visit" Command="{Binding StartVisitCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Complete" Command="{Binding CompleteCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
            <Button Content="Open Consultation" Command="{Binding OpenConsultationCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
            <Button Content="Generate Bill" Command="{Binding GenerateBillCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,0" />
            <TextBox Width="220"
                     Text="{Binding CancellationReason, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Cancellation reason"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,8,0" />
            <Button Content="Cancel Appointment" Command="{Binding CancelAppointmentCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
        </StackPanel>
    </Grid>
</UserControl>
