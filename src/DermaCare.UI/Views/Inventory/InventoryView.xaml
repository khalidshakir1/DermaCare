<UserControl x:Class="DermaCare.UI.Views.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,16">
            <materialDesign:Card Padding="16" Width="190" Margin="0,0,12,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Medicines" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.7" />
                    <TextBlock Text="{Binding Medicines.Count}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="190" Margin="0,0,12,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Low Stock Alerts" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.7" />
                    <TextBlock Text="{Binding LowStockCount}" Foreground="#D32F2F" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="190" Margin="0,0,12,0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Expiring (60 Days)" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.7" />
                    <TextBlock Text="{Binding ExpiringCount}" Foreground="#EF6C00" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="220" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Stock Value (Cost)" Style="{StaticResource MaterialDesignCaptionTextBlock}" Opacity="0.7" />
                    <TextBlock Text="{Binding TotalStockValue, StringFormat=C}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>

        <TabControl Grid.Row="1">
            <!-- Tab 1: Medicines & Stock Operations -->
            <TabItem Header="Medicines &amp; Stock">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox Width="280"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search medicine, generic, category..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,8,0" />
                            <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Medicines}"
                                  SelectedItem="{Binding SelectedMedicine}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70" />
                                <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock}" Width="70" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinStockLevel}" Width="60" />
                                <DataGridTextColumn Header="Buy (PKR)" Binding="{Binding PurchasePrice, StringFormat=C}" Width="100" />
                                <DataGridTextColumn Header="Sell (PKR)" Binding="{Binding SellingPrice, StringFormat=C}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Right Panel: Stock In / Dispense / Add Medicine -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <materialDesign:Card Padding="14" Margin="0,0,0,12" UniformCornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Stock In (Purchase Batch)" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding SelectedMedicine.Name, TargetNullValue='Select a medicine from the list'}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Batch No. *" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <DatePicker SelectedDate="{Binding ExpiryDate}" materialDesign:HintAssist.Hint="Expiry Date" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding PurchaseQuantity, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Quantity *" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding BatchPurchasePrice, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Purchase Price (PKR)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding BatchSellingPrice, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Selling Price (PKR)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Supplier / Distributor" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10" />
                                    <Button Content="Add Stock Batch" Command="{Binding AddStockCommand}" Style="{StaticResource MaterialDesignRaisedButton}" />
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="14" Margin="0,0,0,12" UniformCornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Dispense / Adjust Stock" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding AdjustTypes}" SelectedItem="{Binding AdjustType}" materialDesign:HintAssist.Hint="Action Type" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdjustQuantity, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Quantity" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding AdjustNotes, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Notes (Patient / Reason)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10" />
                                    <Button Content="Record Movement" Command="{Binding AdjustStockCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </StackPanel>
                            </materialDesign:Card>

                            <materialDesign:Card Padding="14" UniformCornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Add New Medicine" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding MedName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Medicine Name *" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding MedGeneric, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Generic Name" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding MedCategory}" materialDesign:HintAssist.Hint="Category" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8" />
                                    <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding MedUnit}" materialDesign:HintAssist.Hint="Unit" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding MedMinStock, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Min Stock Alert Level" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding MedPurchasePrice, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Purchase Price (PKR)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding MedSellingPrice, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Selling Price (PKR)" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10" />
                                    <Button Content="Create Medicine" Command="{Binding AddMedicineCommand}" Style="{StaticResource MaterialDesignRaisedButton}" />
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 2: Expiring Batches -->
            <TabItem Header="Expiring Soon">
                <DataGrid Margin="12" ItemsSource="{Binding ExpiringBatches}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine.Name}" Width="200" />
                        <DataGridTextColumn Header="Batch No." Binding="{Binding BatchNumber}" Width="120" />
                        <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat=d}" Width="120" />
                        <DataGridTextColumn Header="Qty Remaining" Binding="{Binding QuantityRemaining}" Width="120" />
                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 3: Stock Ledger -->
            <TabItem Header="Stock Ledger">
                <DataGrid Margin="12" ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=g}" Width="150" />
                        <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine.Name}" Width="190" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="100" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="4,10,0,0" />
    </Grid>
</UserControl>
