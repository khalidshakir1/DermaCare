<UserControl x:Class="DermaCare.UI.Views.Patients.PatientFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <materialDesign:Card Margin="24" Padding="24" MaxWidth="680" UniformCornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           Margin="0,0,0,20" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="First Name *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,14" />

                    <TextBox Grid.Column="2"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Last Name *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,14" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DatePicker Grid.Column="0"
                                SelectedDate="{Binding DateOfBirth}"
                                materialDesign:HintAssist.Hint="Date of Birth *"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Margin="0,0,0,14" />

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding Genders}"
                              SelectedItem="{Binding Gender}"
                              materialDesign:HintAssist.Hint="Gender *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,14" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Phone * (03XX-XXXXXXX)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,14" />

                    <TextBox Grid.Column="2"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Email"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,14" />
                </Grid>

                <TextBox Text="{Binding CNIC, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="CNIC (XXXXX-XXXXXXX-X)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,14" />

                <ComboBox ItemsSource="{Binding SkinTypes}"
                          SelectedItem="{Binding SkinType}"
                          materialDesign:HintAssist.Hint="Fitzpatrick Skin Type"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,14" />

                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Address"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,14" />

                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right"
                            Content="Browse Photo"
                            Command="{Binding BrowsePhotoCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="8,0,0,0" />
                    <TextBox Text="{Binding PhotoPath}"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="Patient Photo (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                </DockPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Save Patient"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>

