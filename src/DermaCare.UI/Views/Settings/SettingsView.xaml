<UserControl x:Class="DermaCare.UI.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Clinic Profile">
                <StackPanel Margin="16" MaxWidth="520">
                    <TextBox Text="{Binding ClinicProfile.ClinicName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Clinic Name" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding ClinicProfile.Address, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Address" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding ClinicProfile.Phone, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Phone" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <TextBox Text="{Binding ClinicProfile.Email, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Email" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" />
                    <Button Content="Save Clinic Profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Users">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBox Width="140" Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Username" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0" />
                        <TextBox Width="170" Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Full Name" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0" />
                        <TextBox Width="140" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Password" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0" />
                        <ComboBox Width="140" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="RoleName" materialDesign:HintAssist.Hint="Role" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,8,0" />
                        <Button Content="Add User" Command="{Binding CreateUserCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                        <Button Content="Toggle Active" Command="{Binding ToggleUserActiveCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140" />
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="200" />
                            <DataGridTextColumn Header="Role" Binding="{Binding Role.RoleName}" Width="130" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Pending Doctor Approvals">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Approve Selected Doctor" Command="{Binding ApproveDoctorCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                        <Button Content="Reject" Command="{Binding RejectDoctorCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PendingDoctors}" SelectedItem="{Binding SelectedPendingDoctor}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="180" />
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                            <DataGridTextColumn Header="PMDC No." Binding="{Binding DoctorProfile.PMDCNumber}" Width="140" />
                            <DataGridTextColumn Header="Specialization" Binding="{Binding DoctorProfile.Specialization}" Width="140" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding DoctorProfile.Phone}" Width="130" />
                            <DataGridTextColumn Header="Registered" Binding="{Binding CreatedAt, StringFormat=d}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Service Catalog">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="220" Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Service Name" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0" />
                        <TextBox Width="110" Text="{Binding NewServicePrice, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Price" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0" />
                        <TextBox Width="140" Text="{Binding NewServiceCategory, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Category" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,8,0" />
                        <Button Content="Add Service" Command="{Binding AddServiceCommand}" Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="240" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                            <DataGridTextColumn Header="Price" Binding="{Binding DefaultPrice, StringFormat=C}" Width="120" />
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Audit Logs">
                <DataGrid Margin="16" ItemsSource="{Binding AuditLogs}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="170" />
                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="90" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120" />
                        <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="140" />
                        <DataGridTextColumn Header="Record ID" Binding="{Binding RecordId}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Database Backup">
                <StackPanel Margin="16" MaxWidth="520">
                    <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Backup Destination Folder" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />
                    <Button Content="Run SQL Server Backup Now" Command="{Binding BackupCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontWeight="SemiBold" Margin="4,12,0,0" />
    </Grid>
</UserControl>

