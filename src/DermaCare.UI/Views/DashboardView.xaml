<UserControl x:Class="DermaCare.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <StackPanel Margin="24">
        <materialDesign:Card Padding="24" UniformCornerRadius="8" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding WelcomeTitle}"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           Margin="0,0,0,8" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           Opacity="0.8" />
            </StackPanel>
        </materialDesign:Card>

        <WrapPanel>
            <materialDesign:Card Padding="20" Width="240" UniformCornerRadius="8" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Today's Appointments"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding TodaysAppointmentCount}"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="20" Width="240" UniformCornerRadius="8" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Low Stock Medicines"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding LowStockCount}"
                               Foreground="#D32F2F"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="20" Width="240" UniformCornerRadius="8" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Expiring Soon (60 Days)"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding ExpiringSoonCount}"
                               Foreground="#EF6C00"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="20" Width="260" UniformCornerRadius="8" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Today's Revenue"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Opacity="0.7" />
                    <TextBlock Text="{Binding TodaysRevenue, StringFormat='Rs. {0:N0}'}"
                               Foreground="#00796B"
                               Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>
    </StackPanel>
</UserControl>

