<UserControl x:Class="DermaCare.UI.Views.Billing.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Create New Bill -->
        <materialDesign:Card Grid.Column="0" Padding="18" UniformCornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" />
                        <TextBlock Text="Create New Bill"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Patient Selection -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Name / Code / CNIC..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding Patients}"
                                  SelectedItem="{Binding SelectedPatient}"
                                  DisplayMemberPath="FullName"
                                  materialDesign:HintAssist.Hint="Select Patient"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </Grid>

                    <!-- Item Entry Tabs -->
                    <TabControl Margin="0,0,0,10">
                        <TabItem Header="Consultation">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                <TextBox Width="160"
                                         Text="{Binding ConsultationFee, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Consultation Fee (Rs.)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />
                                <Button Content="Add Consultation"
                                        Command="{Binding AddConsultationCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Service / Procedure">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                <ComboBox Width="250"
                                          ItemsSource="{Binding Services}"
                                          SelectedItem="{Binding SelectedService}"
                                          materialDesign:HintAssist.Hint="Service"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ServiceName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Width="65"
                                         Text="{Binding ServiceQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Qty"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />
                                <Button Content="Add Service"
                                        Command="{Binding AddServiceCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Medicine (Stock)">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                <ComboBox Width="260"
                                          ItemsSource="{Binding Medicines}"
                                          SelectedItem="{Binding SelectedMedicine}"
                                          materialDesign:HintAssist.Hint="Medicine"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Margin="0,0,8,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CurrentStock, StringFormat=' (Stock: {0})'}" Opacity="0.7" />
                                                <TextBlock Text="{Binding SellingPrice, StringFormat=' - Rs. {0:N0}'}" Foreground="#00796B" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Width="65"
                                         Text="{Binding MedicineQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Qty"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />
                                <Button Content="Add Medicine"
                                        Command="{Binding AddMedicineCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="Custom">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                <TextBox Width="190"
                                         Text="{Binding CustomDescription, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Description"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />
                                <TextBox Width="90"
                                         Text="{Binding CustomPrice, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Price (Rs.)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />
                                <TextBox Width="55"
                                         Text="{Binding CustomQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Qty"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />
                                <Button Content="Add"
                                        Command="{Binding AddCustomItemCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- Line Items Table -->
                    <DataGrid ItemsSource="{Binding LineItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Height="170"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="90" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50" />
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat='Rs. {0:N0}'}" Width="85" />
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat='Rs. {0:N0}'}" Width="90" />
                            <DataGridTemplateColumn Header="" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="X"
                                                Command="{Binding DataContext.RemoveLineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Padding="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Notes, Discounts & Initial Payment -->
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Notes (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Width="140"
                                 Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Discount (Rs.)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,8,0" />
                        <TextBox Width="130"
                                 Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Discount (%)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,12,0" />
                        <TextBlock Text="{Binding DraftSubtotal, StringFormat='Subtotal: Rs. {0:N0}'}"
                                   VerticalAlignment="Center"
                                   Opacity="0.75" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBox Width="135"
                                 Text="{Binding InitialPaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Pay Now (Rs.)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,6,0" />
                        <Button Content="Full"
                                Command="{Binding FillInitialFullCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding InitialPaymentMethod}"
                                  materialDesign:HintAssist.Hint="Method"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                    </StackPanel>

                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Create Bill"
                                Command="{Binding CreateInvoiceCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        <TextBlock Text="{Binding DraftTotal, StringFormat='Total: Rs. {0:N2}'}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Right: Bills & Payments -->
        <materialDesign:Card Grid.Column="2" Padding="18" UniformCornerRadius="8">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Bills &amp; Payments"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <TextBox Text="{Binding BillSearch, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search by Bill # or Patient Name..."
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" />

                <DataGrid ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Height="250"
                          Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill #" Binding="{Binding BillNumber}" Width="95" />
                        <DataGridTextColumn Header="Patient" Binding="{Binding Patient.FullName}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding IssuedAt, StringFormat='dd/MM/yyyy'}" Width="85" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N0}'}" Width="80" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N0}'}" Width="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Record Payment for Selected Bill"
                           Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                           Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBox Width="115"
                             Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Amount (Rs.)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,6,0" />
                    <Button Content="Full"
                            Command="{Binding FillBalanceCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" />
                    <ComboBox Width="135"
                              ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding PaymentMethod}"
                              materialDesign:HintAssist.Hint="Method"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,8,0" />
                    <Button Content="Pay"
                            Command="{Binding RecordPaymentCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Print Receipt (80mm)"
                            Command="{Binding PrintBillCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Export PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="#00796B"
                           TextWrapping="Wrap" />
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
