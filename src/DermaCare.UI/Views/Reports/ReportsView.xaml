<UserControl x:Class="DermaCare.UI.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="Today (Daily Closing)" Command="{Binding DailyClosingCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6" />
            <Button Content="Weekly (Last 7 Days)" Command="{Binding WeeklyReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6" />
            <Button Content="Monthly (This Month)" Command="{Binding MonthlyReportCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,16,6" />
            <DatePicker Width="140" SelectedDate="{Binding FromDate}" materialDesign:HintAssist.Hint="From" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,6" />
            <DatePicker Width="140" SelectedDate="{Binding ToDate}" materialDesign:HintAssist.Hint="To" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,10,6" />
            <Button Content="Generate" Command="{Binding GenerateCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,6" />
            <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6" />
            <Button Content="Export Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,6" />
        </WrapPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,10" />

        <WrapPanel Grid.Row="2" Margin="0,0,0,16">
            <materialDesign:Card Padding="16" Width="170" Margin="0,0,12,8" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Appointments" Opacity="0.7" />
                    <TextBlock Text="{Binding TotalAppointments}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="170" Margin="0,0,12,8" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Completed" Opacity="0.7" />
                    <TextBlock Text="{Binding CompletedAppointments}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="170" Margin="0,0,12,8" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="New Patients" Opacity="0.7" />
                    <TextBlock Text="{Binding NewPatients}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="190" Margin="0,0,12,8" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Total Billed" Opacity="0.7" />
                    <TextBlock Text="{Binding TotalBilled, StringFormat='Rs. {0:N0}'}" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Padding="16" Width="190" Margin="0,0,12,8" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Collected" Opacity="0.7" />
                    <TextBlock Text="{Binding TotalCollected, StringFormat='Rs. {0:N0}'}" Foreground="#00796B" Style="{StaticResource MaterialDesignHeadline5TextBlock}" />
                </StackPanel>
            </materialDesign:Card>
        </WrapPanel>

        <TabControl Grid.Row="3">
            <TabItem Header="Collection by Payment Method">
                <DataGrid ItemsSource="{Binding RevenueByMethod}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Payment Method" Binding="{Binding Method}" Width="220" />
                        <DataGridTextColumn Header="Transactions" Binding="{Binding Count}" Width="140" />
                        <DataGridTextColumn Header="Amount Collected" Binding="{Binding Amount, StringFormat='Rs. {0:N2}'}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Company Purchases">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Width="230"
                                 Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Filter Company (e.g. GSK)..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,8,0" />
                        <Button Content="Filter" Command="{Binding GenerateCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding TotalCompanyPurchaseCost, StringFormat='Total Purchased: Rs. {0:N0}'}"
                                   FontWeight="Bold"
                                   Foreground="#1565C0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CompanyPurchases}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Company / Supplier" Binding="{Binding CompanyName}" Width="220" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Batches" Binding="{Binding BatchCount}" Width="90" />
                            <DataGridTextColumn Header="Units Purchased" Binding="{Binding TotalUnitsPurchased}" Width="140" />
                            <DataGridTextColumn Header="Purchase Cost (PKR)" Binding="{Binding TotalPurchaseCost, StringFormat='Rs. {0:N2}'}" Width="170" />
                            <DataGridTextColumn Header="Remaining Stock" Binding="{Binding CurrentUnitsRemaining}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Bills">
                <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bill #" Binding="{Binding BillNumber}" Width="110" />
                        <DataGridTextColumn Header="Patient" Binding="{Binding Patient.FullName}" Width="200" />
                        <DataGridTextColumn Header="Date" Binding="{Binding IssuedAt, StringFormat='dd/MM/yyyy'}" Width="100" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N0}'}" Width="110" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N0}'}" Width="110" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Appointments">
                <DataGrid ItemsSource="{Binding Appointments}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding AppointmentDate, StringFormat='dd/MM/yyyy'}" Width="110" />
                        <DataGridTextColumn Header="Time" Binding="{Binding AppointmentTime}" Width="90" />
                        <DataGridTextColumn Header="Patient" Binding="{Binding Patient.FullName}" Width="200" />
                        <DataGridTextColumn Header="Doctor" Binding="{Binding Doctor.User.FullName}" Width="200" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
